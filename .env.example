# Password for the Oracle SYS/SYSTEM accounts (administration only; the app never uses it).
ORACLE_PWD=replace-with-a-long-random-password
# Application schema created on first start of the Oracle container. The password must not contain double quotes.
ORACLE_APP_USER=sitehub
ORACLE_APP_PASSWORD=replace-with-another-long-random-password
# oracle://user:password@host:port/service_name. URL-encode special characters in the password.
# Inside Compose the host is "oracle"; for a host-run backend use 127.0.0.1 (service name FREEPDB1).
DATABASE_URL=oracle://sitehub:replace-with-another-long-random-password@oracle:1521/FREEPDB1

# Used only to initialize the administrator account in a new database.
# Generate with bun run hash-password (password supplied on stdin).
ADMIN_PASSWORD_HASH_BASE64=
# Required for storing/revealing account secret keys. Generate with: openssl rand -hex 32
ACCOUNT_ENCRYPTION_KEY=
SESSION_SECRET=replace-with-32-or-more-random-characters
APP_ORIGIN=http://localhost:8111
# Optional additional exact browser origins, comma-separated (for example a LAN IP).
APP_ORIGINS=
COOKIE_SECURE=false
API_PORT=3000
