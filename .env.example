# PostgreSQL container settings (also used to build DATABASE_URL below).
POSTGRES_USER=sitehub
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=sitehub
# postgres://user:password@host:port/database. URL-encode special characters in the password.
# Inside Compose the host is "postgres"; for a host-run backend use 127.0.0.1.
DATABASE_URL=postgres://sitehub:replace-with-a-long-random-password@postgres:5432/sitehub

# Required for storing/revealing account secret keys. Generate with: openssl rand -hex 32
ACCOUNT_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:8111
# Optional additional exact browser origins, comma-separated (for example a LAN IP).
APP_ORIGINS=
API_PORT=3000
