{
  "name": "website-admin",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix src/APH.SiteHub.Ui install",
    "dev": "node --env-file-if-exists=.env scripts/backend.mjs dev",
    "dev:frontend": "npm --prefix src/APH.SiteHub.Ui run dev",
    "aspire": "dotnet run --project src/APH.SiteHub.AppHost",
    "typecheck": "dotnet build APH.SiteHub.sln",
    "build": "dotnet build APH.SiteHub.sln -c Release && npm --prefix src/APH.SiteHub.Ui run build",
    "test": "dotnet test APH.SiteHub.sln && npm --prefix src/APH.SiteHub.Ui run test",
    "test:backend": "dotnet test APH.SiteHub.sln",
    "migrate": "node --env-file-if-exists=.env scripts/backend.mjs migrate",
    "lint": "eslint scripts && npm --prefix src/APH.SiteHub.Ui run check",
    "format": "prettier --write . && dotnet format APH.SiteHub.sln",
    "format:check": "prettier --check . && dotnet format APH.SiteHub.sln --verify-no-changes"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@tanstack/redact": "^0.3.1"
  }
}
